<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    Shigodeki ExportOptions for TestFlight

    このファイルはIPAエクスポート時に使用されます。
    チーム設定は自動検出されますが、問題がある場合は以下を設定してください:

    teamID: Apple Developer Team ID（例: ABC123DEF4）
    signingCertificate: 証明書名（例: Apple Distribution: Your Name）
    provisioningProfiles: プロビジョニングプロファイルのマッピング
    -->

    <!-- App Store Connect / TestFlight 用 -->
    <key>method</key>
    <string>app-store-connect</string>

    <!-- 自動署名を使用 -->
    <key>signingStyle</key>
    <string>automatic</string>

    <!-- Bitcode（App Storeへのアップロード時は自動で再コンパイルされる） -->
    <key>compileBitcode</key>
    <false/>

    <!-- シンボル情報をAppleにアップロード（クラッシュレポート用） -->
    <key>uploadSymbols</key>
    <true/>

    <!-- App Thinning（デバイスに最適化されたバイナリ） -->
    <key>thinning</key>
    <string>&lt;none&gt;</string>

    <!--
    手動署名が必要な場合は以下のコメントを解除して設定:

    <key>teamID</key>
    <string>YOUR_TEAM_ID</string>

    <key>signingCertificate</key>
    <string>Apple Distribution</string>

    <key>provisioningProfiles</key>
    <dict>
        <key>com.hiroshikodera.shigodeki</key>
        <string>Shigodeki App Store Profile</string>
    </dict>
    -->
</dict>
</plist>
